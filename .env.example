# Supabase project URL (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anonymous key (safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Never add the Supabase service-role key here or expose it with NEXT_PUBLIC_.
